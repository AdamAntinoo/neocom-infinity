{
	"version": "0.2.0",
	"configurations": [
	  {
		"name": ">Debug>Development",
		"type": "node",
		"request": "launch",
		"args": [
		  "${workspaceFolder}/src/main.ts"
		],
		"env": {
		  "NODE_ENV": "development"
		},
		"runtimeArgs": [
		  "--nolazy",
		  "-r",
		  "ts-node/register",
		  "-r",
		  "tsconfig-paths/register"
		],
		"sourceMaps": true,
		"envFile": "${workspaceFolder}/.env.development",
		"cwd": "${workspaceRoot}",
		"console": "integratedTerminal",
		"protocol": "inspector"
	  }
	]
  }
  